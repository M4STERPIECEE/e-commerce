# ============================================================
# Root .gitignore — E-Commerce project
# (Backend build artifacts are handled by backend/.gitignore)
# ============================================================

# === Secrets / environment files ===
# Keep only the template (.env.example); ignore everything else
.env
.env.*
!.env.example

# === IDE: IntelliJ IDEA ===
.idea/
*.iml
*.iws
*.ipr
out/

# === IDE: VS Code ===
.vscode/

# === IDE: Eclipse / Spring Tools Suite ===
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
bin/

# === Operating system files ===
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# === Logs ===
*.log
logs/

# === Frontend (Node) — when the frontend is added ===
node_modules/
dist/
.next/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
