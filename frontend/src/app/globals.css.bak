@config "../../tailwind.config.js";
@import "tailwindcss";

@layer base {
    html {
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
    }
    body {
        @apply bg-ink-50 text-ink-900 font-sans antialiased;
        font-feature-settings: 'cv11', 'ss01';
    }
    * {
        @apply border-ink-200;
    }
    h1, h2, h3, h4, h5 {
        @apply font-display tracking-tight text-ink-900;
    }
    ::selection {
        @apply bg-accent-500/20 text-accent-900;
    }
}

@layer components {
    .container-app {
        @apply mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8;
    }
    .skeleton {
        @apply relative overflow-hidden bg-ink-100 rounded-md;
    }
    .skeleton::after {
        @apply absolute inset-0 -translate-x-full animate-shimmer;
        content: '';
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
    }
    .input-base {
        @apply w-full rounded-lg border border-ink-200 bg-white px-3.5 py-2.5 text-sm text-ink-900
        placeholder:text-ink-400 transition focus:border-accent-500 focus:outline-none
        focus:ring-2 focus:ring-accent-500/20 disabled:bg-ink-50 disabled:text-ink-400;
    }
    .input-error {
        @apply border-danger-400 focus:border-danger-400 focus:ring-danger-400/20;
    }
    .card {
        @apply rounded-2xl border border-ink-200/70 bg-white shadow-soft;
    }
    .card-hover {
        @apply transition duration-300 hover:shadow-pop hover:-translate-y-0.5;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
}

@layer utilities {
    .text-balance { text-wrap: balance; }
    .scrollbar-thin::-webkit-scrollbar { width: 6px; height: 6px; }
    .scrollbar-thin::-webkit-scrollbar-thumb { @apply bg-ink-200 rounded-full; }
}
